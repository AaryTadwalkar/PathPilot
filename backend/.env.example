##############################
# PostgreSQL
##############################

POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=pathpilot

DATABASE_URL=postgresql://admin:password123@localhost:5432/pathpilot
DATABASE_URL_DOCKER=postgresql://admin:password123@postgres:5432/pathpilot

##############################
# MinIO
##############################

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123

MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT_DOCKER=minio:9000

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=resumes

##############################
# Gemini
##############################

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

##############################
# Job APIs
##############################

JSEARCH_API_KEY=YOUR_JSEARCH_API_KEY
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY

##############################
# Authentication
##############################

JWT_SECRET=CHANGE_THIS_SECRET
SECRET_KEY=CHANGE_THIS_SECRET

##############################
# SMTP
##############################

SMTP_USERNAME=example@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD

##############################
# PRS
##############################

PRS_DETERMINISTIC_MODE=true
