# -- Database (Render PostgreSQL connection string) ----------------
DATABASE_URL=postgresql://user:password@host:5432/pathpilot

# -- AI ------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key

# -- Auth ----------------------------------------------------------
SECRET_KEY=your_random_secret_min_32_chars

# -- Email OTP -----------------------------------------------------
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# -- CORS (set to your Vercel URL in production) -------------------
FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000

# -- PathPilot config ---------------------------------------------
PRS_DETERMINISTIC_MODE=false
PATHPILOT_DATASET_DIR=../datasets
