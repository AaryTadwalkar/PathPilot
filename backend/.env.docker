# .env.docker — Environment variables for Docker Compose
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env when running with Docker.
# IMPORTANT: Use 'postgres' as the DB hostname (Docker service name),
#            NOT 'localhost' (which would point inside the backend container).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://admin:password123@postgres:5432/imperium

# ── Object Storage ────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=resumes

# ── LLM (fill in your real Gemini API key) ───────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── PRS Dataset path (inside container — do NOT change) ──────────────────────
PRS_DATASET_DIR=/app/datasets

# ── HuggingFace model cache ───────────────────────────────────────────────────
HF_HOME=/app/.cache/hf
TRANSFORMERS_CACHE=/app/.cache/hf

# ── Application security ──────────────────────────────────────────────────────
JWT_SECRET=super_secret_key_for_auth
SECRET_KEY=09de7751ea255a1830c05654d9a7f8ad5cb9ccd81fc45b6737d73f8beedc62cc

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_USERNAME=
SMTP_PASSWORD=

# ── External APIs (optional for Module 1) ────────────────────────────────────
JSEARCH_API_KEY=
RAPIDAPI_KEY=
